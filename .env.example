# Copiar a .env y ajustar. Valores comunes a todos los stacks y a los scripts de host/.

# Dominio gestionado en Cloudflare. Lo interno cuelga de INT_DOMAIN (wildcard *.int.<dominio>).
BASE_DOMAIN=example.com
INT_DOMAIN=int.example.com
REGISTRY_HOST=registry.int.example.com

# Red local del servidor
LAN_IP=192.168.1.50
LAN_SUBNET=192.168.1.0/24

# UUID de la partición ext4 del HDD (sudo blkid). Vacío = no montar HDD.
HDD_UUID=

# Rutas del host. SSD: datos de servicios y apps. HDD: registry, métricas, logs, backups.
DATA_DIR=/srv/mercury/data
APPS_DIR=/srv/mercury/apps
INBOX_DIR=/srv/mercury/sftp/inbox
HDD_DIR=/mnt/hdd/mercury

TZ=UTC
