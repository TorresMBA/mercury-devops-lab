// Plantilla CI para Flask. Copiar a la raíz del repo de la app y ajustar APP.
pipeline {
  agent none

  options {
    timestamps()
    // Un push nuevo cancela el build anterior de este job, aunque esté esperando en "Aprobar prod"
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    // Excepción puntual: despliega sin SonarQube, Semgrep ni trivy-fs y deja el build UNSTABLE
    booleanParam(name: 'SKIP_ANALYSIS', defaultValue: false, description: 'Saltar SonarQube, Semgrep y Trivy del código')
  }

  environment {
    APP = 'mi-flask' // nombre de imagen y contenedor: minúsculas y guiones
    TAG = "${BUILD_NUMBER}"
  }

  stages {
    stage('CI') {
      // 'python' es la versión por defecto. Para fijar otra: 'python-3.11', 'python-3.12' o 'python-3.13'.
      // La imagen de la app se empaqueta con la misma versión que el agente.
      agent { label 'python' }
      options {
        // Un build colgado no debe ocupar un cupo de agente indefinidamente
        timeout(time: 45, unit: 'MINUTES')
      }
      environment {
        REGISTRY = credentials('registry')
      }
      stages {
        stage('Test') {
          steps {
            // pytest devuelve 5 cuando no encuentra tests: no se considera fallo
            sh '''
              python3 -m venv .venv
              . .venv/bin/activate
              pip install --quiet -r requirements.txt pytest
              pytest || [ $? -eq 5 ]
            '''
          }
        }

        stage('SonarQube') {
          when { expression { !params.SKIP_ANALYSIS } }
          steps {
            withSonarQubeEnv('sonarqube') {
              sh 'mercury-ci sonar "$APP" "-Dsonar.exclusions=.venv/**"'
            }
          }
        }

        // La espera del quality gate no consume recursos: los escáneres corren mientras tanto
        stage('Análisis') {
          when { expression { !params.SKIP_ANALYSIS } }
          failFast true
          parallel {
            stage('Quality gate') {
              steps {
                timeout(time: 10, unit: 'MINUTES') {
                  waitForQualityGate abortPipeline: true
                }
              }
            }

            stage('Seguridad') {
              steps {
                sh '''
                  rm -rf .venv
                  mercury-ci semgrep
                  mercury-ci trivy-fs
                '''
              }
            }
          }
        }

        stage('Análisis omitido') {
          when { expression { params.SKIP_ANALYSIS } }
          steps {
            unstable 'SKIP_ANALYSIS: sin SonarQube, Semgrep ni trivy-fs'
          }
        }

        stage('Imagen') {
          steps {
            sh '''
              mercury-ci login
              mercury-ci package flask . "$APP" "$TAG"
              mercury-ci trivy-image "$(mercury-ci image-ref "$APP" "$TAG")"
            '''
          }
        }

        stage('Deploy dev') {
          steps {
            sh 'mercury-ci deploy "$APP" dev "$TAG"'
          }
        }
      }
      post {
        always {
          // El agente es efímero: sin esto el informe de Semgrep se pierde
          archiveArtifacts artifacts: 'semgrep.json', allowEmptyArchive: true
        }
      }
    }

    // Sin agente: la espera no ocupa RAM ni un cupo de agente
    stage('Aprobar prod') {
      steps {
        timeout(time: 1, unit: 'DAYS') {
          input message: "¿Promover ${APP}:${TAG} a prod?${params.SKIP_ANALYSIS ? ' (SIN análisis de código)' : ''}"
        }
      }
    }

    stage('Deploy prod') {
      agent { label 'base' }
      environment {
        REGISTRY = credentials('registry')
      }
      options {
        skipDefaultCheckout()
        timeout(time: 10, unit: 'MINUTES')
      }
      steps {
        sh '''
          mercury-ci login
          mercury-ci deploy "$APP" prod "$TAG"
        '''
      }
    }
  }
}
