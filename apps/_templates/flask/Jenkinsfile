// Plantilla CI para Flask. Copiar a la raíz del repo de la app y ajustar APP.
pipeline {
  agent none

  options {
    timestamps()
    // Un push nuevo cancela el build anterior de este job, aunque esté esperando en "Aprobar prod"
    disableConcurrentBuilds(abortPrevious: true)
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    APP = 'mi-flask' // nombre de imagen y contenedor: minúsculas y guiones
    TAG = "${BUILD_NUMBER}"
  }

  stages {
    stage('CI') {
      // 'python' es la versión por defecto. Para fijar otra: 'python-3.11', 'python-3.12' o 'python-3.13'.
      // La imagen de la app se empaqueta con la misma versión que el agente.
      agent { label 'python' }
      environment {
        REGISTRY = credentials('registry')
      }
      stages {
        stage('Test') {
          steps {
            // pytest devuelve 5 cuando no encuentra tests: no se considera fallo
            sh '''
              python3 -m venv .venv
              . .venv/bin/activate
              pip install --quiet -r requirements.txt pytest
              pytest || [ $? -eq 5 ]
            '''
          }
        }

        stage('SonarQube') {
          steps {
            withSonarQubeEnv('sonarqube') {
              sh 'mercury-ci sonar "$APP" "-Dsonar.exclusions=.venv/**"'
            }
          }
        }

        stage('Quality gate') {
          steps {
            timeout(time: 10, unit: 'MINUTES') {
              waitForQualityGate abortPipeline: true
            }
          }
        }

        stage('Seguridad') {
          steps {
            sh '''
              rm -rf .venv
              mercury-ci semgrep
              mercury-ci trivy-fs
            '''
          }
        }

        stage('Imagen') {
          steps {
            sh '''
              mercury-ci login
              mercury-ci package flask . "$APP" "$TAG"
              mercury-ci trivy-image "$(mercury-ci image-ref "$APP" "$TAG")"
            '''
          }
        }

        stage('Deploy dev') {
          steps {
            sh 'mercury-ci deploy "$APP" dev "$TAG"'
          }
        }
      }
    }

    // Sin agente: la espera no ocupa RAM ni un cupo de agente
    stage('Aprobar prod') {
      steps {
        timeout(time: 1, unit: 'DAYS') {
          input message: "¿Promover ${APP}:${TAG} a prod?"
        }
      }
    }

    stage('Deploy prod') {
      agent { label 'base' }
      environment {
        REGISTRY = credentials('registry')
      }
      options { skipDefaultCheckout() }
      steps {
        sh '''
          mercury-ci login
          mercury-ci deploy "$APP" prod "$TAG"
        '''
      }
    }
  }
}
