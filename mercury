#!/usr/bin/env bash
# mercury — operador de los stacks del servidor. Uso: ./mercury help
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
TEMPLATES="$ROOT/apps/_templates"
# Stacks como <grupo>/<stack>, en orden de arranque para "all"
STACKS=(
  core/dns
  core/edge
  core/management
  devops/registry
  devops/jenkins
  devops/sonarqube
  monitoring/metrics
  monitoring/logs
  monitoring/grafana
  storage/files
)
JENKINS_DIR="$ROOT/stacks/devops/jenkins"
DNS_DIR="$ROOT/stacks/core/dns"
RUNTIMES=(dotnet spring flask node static)
# Catálogo de agentes de Jenkins como <agente>:<versión>. Estar aquí no implica estar
# construido: solo se publican los que se piden con `./mercury agents <agente>:<versión>`.
# Cada entrada necesita su plantilla en stacks/devops/jenkins/casc/jenkins.yaml.
AGENTS=(
  dotnet:8.0 dotnet:9.0 dotnet:10.0
  maven:8 maven:11 maven:17 maven:21 maven:25
  node:20 node:22 node:24
  python:3.11 python:3.12 python:3.13
)
# Versión que se usa al pedir el agente sin versión (etiqueta `dotnet`, `maven`...)
declare -A AGENT_DEFAULT=([dotnet]=10.0 [maven]=21 [node]=22 [python]=3.12)

die() { echo "error: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Uso: ./mercury <comando> [argumentos]

Un <destino> es un stack (jenkins), un grupo (devops) o "all". Ver: ./mercury list

Stacks:
  list                  Grupos y stacks disponibles
  up <destino>          Levanta
  down <destino>        Detiene y elimina los contenedores (los datos se conservan)
  restart <destino>     Reinicia los contenedores
  ps <destino>          Estado
  pull <destino>        Descarga las imágenes fijadas en su .env
  config <destino>      Muestra el compose resuelto (valida sintaxis y variables)
  logs <stack> [svc]    Logs en vivo
  build <stack>         Reconstruye imágenes propias (jenkins)
  compose <stack> ...   Pasa argumentos directos a docker compose

DNS interno:
  dns-init              Genera la configuración inicial de AdGuard Home
  check-dns [nombre]    Diagnostica por qué no resuelve o no responde un nombre interno
                        (por defecto, el del registry)

Agentes de Jenkins (imágenes en el registry):
  agents list                       Catálogo de versiones y cuáles están publicadas
  agents <agente>[:<versión>] ...   Construye y publica solo esos (dotnet:8.0, maven:17, base)
                                    Sin versión se usa la de por defecto del agente
  agents                            Reconstruye la base y los agentes ya publicados
  agents rollback <agente>:<versión> <commit>
                                    Vuelve a la imagen construida en ese commit

Apps:
  quick <app> <runtime> [versión]   Modo rápido (dev): sirve INBOX_DIR/<app> con bind-mount
                        runtimes: dotnet spring flask node static
  deploy <app> <dev|prod> <tag>   Despliega la imagen apps/<app>:<tag> del registry
  undeploy <app> <dev|prod>       Elimina el contenedor de la app

Registry:
  registry-user <user>  Crea o actualiza un usuario (htpasswd)
  registry-gc           Libera espacio de capas sin referencias

Operación:
  backup                Ejecuta el backup ahora (requiere host/05-backup.sh)
EOF
}

[[ $# -ge 1 ]] || { usage; exit 1; }
[[ "$1" == help || "$1" == -h || "$1" == --help ]] && { usage; exit 0; }

[[ -f "$ROOT/.env" ]] || die "falta $ROOT/.env (copia .env.example y ajústalo)"
set -a; . "$ROOT/.env"; set +a

# Traduce un destino a entradas de STACKS, una por línea.
# Acepta "all", un grupo (devops), un stack (jenkins) o la ruta completa (devops/jenkins).
resolve_targets() {
  local target="$1" s found=0
  for s in "${STACKS[@]}"; do
    if [[ "$target" == all || "$s" == "$target" || "${s%%/*}" == "$target" || "${s##*/}" == "$target" ]]; then
      echo "$s"
      found=1
    fi
  done
  [[ $found -eq 1 ]] || die "no existe el stack o grupo '$target' (ver ./mercury list)"
}

# Como resolve_targets, pero exige que el destino sea un único stack
resolve_one() {
  local out
  out="$(resolve_targets "$1")"
  [[ "$out" != *$'\n'* ]] || die "'$1' es un grupo; este comando necesita un stack (ver ./mercury list)"
  echo "$out"
}

compose() { # compose <grupo/stack> <args...>
  local stack="$1"; shift
  local dir="$ROOT/stacks/$stack"
  [[ -f "$dir/.env" ]] || die "falta stacks/$stack/.env (copia stacks/$stack/.env.example y ajústalo)"
  # Jenkins carga además los tokens de git desde credentials.env (env_file de su compose)
  [[ "$dir" != "$JENKINS_DIR" || -f "$dir/credentials.env" ]] || die "falta stacks/$stack/credentials.env (copia stacks/$stack/credentials.env.example y ajústalo)"
  docker compose --env-file "$ROOT/.env" --env-file "$dir/.env" -f "$dir/compose.yaml" "$@"
}

for_stacks() { # for_stacks <destino> <args...>
  local target="$1"; shift
  local targets s
  targets="$(resolve_targets "$target")"
  if [[ "$targets" != *$'\n'* ]]; then
    compose "$targets" "$@"
    return
  fi
  # Varios stacks: los que aún no tienen .env se omiten en lugar de abortar
  while IFS= read -r s; do
    if [[ ! -f "$ROOT/stacks/$s/.env" ]]; then
      echo "-- $s: omitido (sin .env)"
      continue
    fi
    echo "-- $s"
    compose "$s" "$@"
  done <<< "$targets"
}

valid_app() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,40}[a-z0-9])?$ ]] || die "nombre de app inválido: '$1' (minúsculas, números y guiones)"
}

valid_env() {
  [[ "$1" == dev || "$1" == prod ]] || die "ambiente inválido: '$1' (dev o prod)"
}

cmd="$1"; shift
case "$cmd" in
  list)
    group=""
    for s in "${STACKS[@]}"; do
      if [[ "${s%%/*}" != "$group" ]]; then
        group="${s%%/*}"
        printf '%s\n' "$group"
      fi
      state="sin .env"
      [[ -f "$ROOT/stacks/$s/.env" ]] && state="configurado"
      printf '  %-12s %s\n' "${s##*/}" "$state"
    done
    ;;

  up)      [[ $# -ge 1 ]] || die "uso: mercury up <destino>";      for_stacks "$1" up -d ;;
  down)    [[ $# -ge 1 ]] || die "uso: mercury down <destino>";    for_stacks "$1" down ;;
  restart) [[ $# -ge 1 ]] || die "uso: mercury restart <destino>"; for_stacks "$1" restart ;;
  ps)      [[ $# -ge 1 ]] || die "uso: mercury ps <destino>";      for_stacks "$1" ps ;;
  pull)    [[ $# -ge 1 ]] || die "uso: mercury pull <destino>";    for_stacks "$1" pull --ignore-buildable ;;
  config)  [[ $# -ge 1 ]] || die "uso: mercury config <destino>";  for_stacks "$1" config ;;
  build)
    [[ $# -ge 1 ]] || die "uso: mercury build <stack>"
    stack="$(resolve_one "$1")"
    compose "$stack" build --pull
    ;;
  logs)
    [[ $# -ge 1 ]] || die "uso: mercury logs <stack> [servicio]"
    stack="$(resolve_one "$1")"; shift
    compose "$stack" logs -f --tail 100 "$@"
    ;;
  compose)
    [[ $# -ge 2 ]] || die "uso: mercury compose <stack> <argumentos>"
    stack="$(resolve_one "$1")"; shift
    compose "$stack" "$@"
    ;;

  dns-init)
    [[ -f "$DNS_DIR/.env" ]] || die "falta stacks/core/dns/.env (copia stacks/core/dns/.env.example y ajústalo)"
    set -a; . "$DNS_DIR/.env"; set +a
    target="$DATA_DIR/adguard/conf/AdGuardHome.yaml"
    if sudo test -f "$target"; then
      echo "Ya existe $target: no se modifica."
      echo "AdGuard guarda ahí los cambios hechos desde el panel. Para empezar de cero, bórralo y repite."
      exit 0
    fi
    sudo test -d "$(dirname "$target")" || die "no existe $(dirname "$target") (ejecuta: sudo bash host/02-disks.sh)"
    [[ "$ADGUARD_PASSWORD" != cambiar* ]] || die "define ADGUARD_PASSWORD en stacks/core/dns/.env"
    command -v htpasswd >/dev/null || die "falta htpasswd (sudo apt install apache2-utils)"
    # AdGuard guarda la contraseña como hash bcrypt; htpasswd imprime "usuario:hash"
    hash="$(htpasswd -B -C 10 -n -i "$ADGUARD_USER" <<< "$ADGUARD_PASSWORD" | tr -d '[:space:]')"
    hash="${hash#*:}"
    [[ "$hash" == \$2* ]] || die "htpasswd no devolvió un hash bcrypt"
    conf="$(grep -v '^#' "$DNS_DIR/AdGuardHome.yaml.tmpl")"
    conf="${conf//__ADGUARD_USER__/$ADGUARD_USER}"
    conf="${conf//__ADGUARD_HASH__/$hash}"
    conf="${conf//__INT_DOMAIN__/$INT_DOMAIN}"
    conf="${conf//__LAN_IP__/$LAN_IP}"
    printf '%s\n' "$conf" | sudo tee "$target" >/dev/null
    sudo chmod 600 "$target"
    echo "Creado $target (*.$INT_DOMAIN -> $LAN_IP). Siguiente: ./mercury up dns"
    ;;

  check-dns)
    name="${1:-$REGISTRY_HOST}"
    [[ "$name" == *.* ]] || name="$name.$INT_DOMAIN" # admite "jenkins" como atajo
    echo "Nombre: $name (esperado: $LAN_IP)"
    running="$(docker ps --format '{{.Names}}')"

    # 1. AdGuard conoce el nombre
    if grep -qx adguard <<< "$running"; then
      answer="$(docker exec adguard nslookup "$name" 127.0.0.1 2>/dev/null \
        | awk '/^Name:/ {f = 1} f && /^Address/ {print $NF; exit}' || true)"
      if [[ "$answer" != "$LAN_IP" ]]; then
        echo "FALLO  AdGuard: responde '${answer:-nada}'."
        echo "       En el panel de AdGuard > Filtros > Reescrituras DNS añade: *.$INT_DOMAIN -> $LAN_IP"
        exit 1
      fi
      echo "ok     AdGuard: $answer"
    else
      echo "aviso  AdGuard no está en marcha (./mercury up dns); se comprueba el DNS que use el servidor."
    fi

    # 2. El servidor lo resuelve (lo usan docker login, pull y push)
    local_ip="$(getent ahostsv4 "$name" | awk '{print $1; exit}' || true)"
    if [[ "$local_ip" != "$LAN_IP" ]]; then
      echo "FALLO  Servidor: obtiene '${local_ip:-nada}'."
      echo "       El servidor no está consultando a AdGuard para $INT_DOMAIN. Ejecuta: sudo bash host/06-dns.sh"
      exit 1
    fi
    echo "ok     Servidor: $local_ip"

    # 3. Un contenedor nuevo lo resuelve (lo necesitan Jenkins y los escáneres).
    #    Se reutiliza la imagen de AdGuard, que ya está descargada y trae nslookup.
    if grep -qx adguard <<< "$running"; then
      image="$(docker inspect adguard --format '{{.Config.Image}}')"
      inner="$(docker run --rm --entrypoint nslookup "$image" "$name" 2>/dev/null \
        | awk '/^Name:/ {f = 1} f && /^Address/ {print $NF; exit}' || true)"
      if [[ "$inner" != "$LAN_IP" ]]; then
        echo "FALLO  Contenedores: obtienen '${inner:-nada}'."
        echo "       Falta la clave \"dns\" en /etc/docker/daemon.json. Ejecuta: sudo bash host/06-dns.sh"
        exit 1
      fi
      echo "ok     Contenedores: $inner"
    fi

    # 4. Nginx Proxy Manager responde por HTTPS
    if code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "https://$name/" 2>&1)"; then
      echo "ok     HTTPS: responde con código $code"
    else
      echo "FALLO  HTTPS: $code"
      echo "       Revisa en Nginx Proxy Manager que exista el Proxy Host de $name con el certificado wildcard."
      exit 1
    fi
    ;;

  agents)
    [[ -f "$JENKINS_DIR/.env" ]] || die "falta stacks/devops/jenkins/.env"
    set -a; . "$JENKINS_DIR/.env"; set +a
    repo="$REGISTRY_HOST/agents"

    # Commit del repo de infraestructura con el que se construye: etiqueta fija de cada imagen
    revision="$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo sin-git)"
    [[ -z "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]] || revision="$revision-dirty"

    # Normaliza "dotnet" o "dotnet:8.0" a una entrada del catálogo
    agent_spec() {
      local name="${1%%:*}" version=""
      [[ "$1" == *:* ]] && version="${1#*:}"
      [[ -n "${AGENT_DEFAULT[$name]:-}" ]] || die "agente desconocido: '$name' (ver ./mercury agents list)"
      [[ -n "$version" ]] || version="${AGENT_DEFAULT[$name]}"
      [[ " ${AGENTS[*]} " == *" $name:$version "* ]] \
        || die "'$name:$version' no está en el catálogo (ver ./mercury agents list). Para añadirla: docs/instalacion/04-operacion-y-futuro.md"
      echo "$name:$version"
    }

    published() { docker manifest inspect "$1" >/dev/null 2>&1; }

    build_base() {
      echo "== base ($revision)"
      # El contexto es la raíz del repo: la imagen base incluye pipelines/lib y apps/_templates
      docker build --pull -t "$repo/base:current" -t "$repo/base:$revision" \
        --build-arg AGENT_VERSION="$AGENT_VERSION" \
        --label org.opencontainers.image.revision="$revision" \
        -f "$JENKINS_DIR/agents/base/Dockerfile" "$ROOT"
      docker push "$repo/base:current"
      docker push "$repo/base:$revision"
      base_ready=1
    }

    # La base se construye como mucho una vez por ejecución, y solo si hace falta
    base_ready=0
    ensure_base() {
      [[ $base_ready -eq 1 ]] && return 0
      if docker image inspect "$repo/base:current" >/dev/null 2>&1 || published "$repo/base:current"; then
        base_ready=1
      else
        build_base
      fi
    }

    build_agent() { # build_agent <agente>:<versión>
      local name="${1%%:*}" version="${1#*:}"
      ensure_base
      echo "== $name:$version ($revision)"
      docker build -t "$repo/$name:$version" -t "$repo/$name:$version-$revision" \
        --build-arg BASE="$repo/base:current" \
        --build-arg VERSION="$version" \
        --label org.opencontainers.image.revision="$revision" \
        "$JENKINS_DIR/agents/$name"
      docker push "$repo/$name:$version"
      docker push "$repo/$name:$version-$revision"
    }

    case "${1:-}" in
      list)
        printf '%-14s %-22s %s\n' AGENTE "ETIQUETA EN JENKINS" PUBLICADA
        state="no"; published "$repo/base:current" && state="sí"
        printf '%-14s %-22s %s\n' base base "$state"
        for a in "${AGENTS[@]}"; do
          name="${a%%:*}"; version="${a#*:}"
          label="$name-$version"
          [[ "${AGENT_DEFAULT[$name]}" == "$version" ]] && label="$label, $name"
          state="no"; published "$repo/$a" && state="sí"
          printf '%-14s %-22s %s\n' "$a" "$label" "$state"
        done
        echo
        echo "Publicar una que falte: ./mercury agents <agente>:<versión>"
        ;;

      rollback)
        [[ $# -eq 3 ]] || die "uso: mercury agents rollback <agente>:<versión> <commit>"
        if [[ "$2" == base ]]; then
          current="$repo/base:current"; fixed="$repo/base:$3"
        else
          spec="$(agent_spec "$2")"
          current="$repo/$spec"; fixed="$repo/$spec-$3"
        fi
        docker pull "$fixed" || die "no existe $fixed (las etiquetas fijas se ven en https://$REGISTRY_HOST)"
        docker tag "$fixed" "$current"
        docker push "$current"
        echo "$current apunta ahora a la imagen de $3. El siguiente build ya la usa."
        ;;

      "")
        # Los agentes heredan de la base: tras cambiarla se reconstruyen los que están en uso
        targets=()
        for a in "${AGENTS[@]}"; do
          if published "$repo/$a"; then targets+=("$a"); fi
        done
        build_base
        for a in "${targets[@]}"; do build_agent "$a"; done
        [[ ${#targets[@]} -gt 0 ]] || echo "No hay agentes publicados todavía. Publica uno con: ./mercury agents <agente>:<versión>"
        ;;

      *)
        # Se validan todos los argumentos antes de construir nada
        targets=()
        for arg in "$@"; do
          if [[ "$arg" == base ]]; then targets+=(base); else targets+=("$(agent_spec "$arg")"); fi
        done
        for t in "${targets[@]}"; do
          if [[ "$t" == base ]]; then build_base; else build_agent "$t"; fi
        done
        ;;
    esac
    ;;

  quick)
    [[ $# -eq 2 || $# -eq 3 ]] || die "uso: mercury quick <app> <runtime> [versión]"
    valid_app "$1"
    [[ " ${RUNTIMES[*]} " == *" $2 "* ]] || die "runtime inválido: '$2' (${RUNTIMES[*]})"
    [[ -d "$INBOX_DIR/$1" ]] || die "no existe $INBOX_DIR/$1"
    # Sin versión, cada compose.quick.yaml usa la de por defecto de su runtime
    [[ $# -eq 3 ]] && export RUNTIME_VERSION="$3"
    APP="$1" docker compose --env-file "$ROOT/.env" -f "$TEMPLATES/$2/compose.quick.yaml" up -d --force-recreate
    echo "Listo: en NPM apunta $1-dev.$INT_DOMAIN a http://$1-dev:8080"
    ;;

  deploy)
    [[ $# -eq 3 ]] || die "uso: mercury deploy <app> <dev|prod> <tag>"
    valid_app "$1"; valid_env "$2"
    APP="$1" APP_ENV="$2" IMAGE="$REGISTRY_HOST/apps/$1:$3" \
      docker compose -f "$TEMPLATES/compose.deploy.yaml" up -d --pull always --wait --wait-timeout 120
    ;;

  undeploy)
    [[ $# -eq 2 ]] || die "uso: mercury undeploy <app> <dev|prod>"
    valid_app "$1"; valid_env "$2"
    docker compose -p "$1-$2" down
    ;;

  registry-user)
    [[ $# -eq 1 ]] || die "uso: mercury registry-user <usuario>"
    file="$DATA_DIR/registry/auth/htpasswd"
    command -v htpasswd >/dev/null || die "falta htpasswd (sudo apt install apache2-utils)"
    if [[ -f "$file" ]]; then
      sudo htpasswd -B "$file" "$1"
    else
      sudo htpasswd -B -c "$file" "$1"
    fi
    ;;

  registry-gc)
    docker exec registry registry garbage-collect --delete-untagged /etc/distribution/config.yml
    ;;

  backup)
    sudo bash "$ROOT/host/backup.sh"
    ;;

  *)
    usage
    die "comando desconocido: $cmd"
    ;;
esac
