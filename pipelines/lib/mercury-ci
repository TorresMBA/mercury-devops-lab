#!/usr/bin/env bash
# mercury-ci — pasos compartidos por todos los pipelines (canal CI y canal manual).
# Va instalado en la imagen base de los agentes. Tras editarlo: ./mercury agents
#
# Los agentes no tienen daemon propio: hablan con el Docker del host (DOCKER_HOST).
# Por eso los escáneres se lanzan como contenedores hermanos que heredan el
# workspace del agente con --volumes-from, en lugar de montar rutas con -v.
set -euo pipefail

: "${REGISTRY_HOST:?REGISTRY_HOST no definido}"

TEMPLATES="${MERCURY_TEMPLATES:-/opt/mercury/templates}"
AGENT_NETWORK="${AGENT_NETWORK:-mercury-jenkins}"
export APPS_DIR="${APPS_DIR:-/srv/mercury/apps}"

TRIVY_IMAGE="${TRIVY_IMAGE:-aquasec/trivy:0.75.0}"
SEMGREP_IMAGE="${SEMGREP_IMAGE:-semgrep/semgrep:1.178.0}"
SONAR_SCANNER_IMAGE="${SONAR_SCANNER_IMAGE:-sonarsource/sonar-scanner-cli:12.2}"

# 0 = los hallazgos se informan pero no rompen el build; 1 = lo rompen
STRICT="${MERCURY_SCAN_STRICT:-0}"
SEVERITY="${MERCURY_SCAN_SEVERITY:-HIGH,CRITICAL}"
# Los escáneres corren fuera del límite de memoria del agente: se les pone uno propio
# para que dos builds a la vez no agoten la RAM del servidor
SCAN_MEMORY="${MERCURY_SCAN_MEMORY:-1536m}"

SELF="$(hostname)" # dentro de un contenedor, el hostname es su ID

# Lo deja trivy-fs cuando termina bien: trivy-image, en el mismo agente, no vuelve a
# actualizar la base de datos. En /tmp y no en el workspace, que puede ser contexto de build.
TRIVY_DB_MARK="${MERCURY_TRIVY_DB_MARK:-/tmp/mercury-trivy-db-al-dia}"

die() { echo "mercury-ci: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Uso: mercury-ci <paso> [argumentos]
  login                               docker login en el registry (REGISTRY_USR / REGISTRY_PSW)
  image-ref <app> <tag>               imprime el nombre completo de la imagen
  check-inbox <app>                   valida que /inbox/<app> existe y tiene contenido
  sonar <clave> [args sonar-scanner]  análisis SonarQube del directorio actual
  semgrep                             SAST del directorio actual
  trivy-fs                            dependencias vulnerables, secretos y configuración
  package <runtime> <dir> <app> <tag> construye la imagen y la publica
  trivy-image <imagen>                vulnerabilidades de la imagen final
  deploy <app> <dev|prod> <tag>       despliega la imagen en el ambiente

Variables que ajustan `package`:
  RUNTIME_VERSION     versión del runtime de la imagen; la define el agente (dotnet-8.0 -> 8.0)
  MERCURY_DOCKERFILE  ruta de un Dockerfile del repo, o "template" para forzar la plantilla
EOF
}

valid_app() {
  [[ "$1" =~ ^[a-z0-9]([a-z0-9-]{0,40}[a-z0-9])?$ ]] || die "nombre de app inválido: '$1' (minúsculas, números y guiones)"
}

image_ref() { echo "$REGISTRY_HOST/apps/$1:$2"; }

# Ejecuta una imagen sobre el workspace del agente, en el mismo directorio
in_workspace() {
  docker run --rm --memory "$SCAN_MEMORY" --volumes-from "$SELF" -w "$PWD" "$@"
}

# Trivy comparte entre builds el volumen con su base de datos. Si dos builds la
# actualizan a la vez, uno falla: se reintenta. El código 10 son hallazgos en modo
# estricto (--exit-code 10) y no se reintenta.
trivy_retry() {
  local attempt code
  for attempt in 1 2 3; do
    code=0
    "$@" || code=$?
    if [[ $code -eq 0 ]]; then
      return 0
    elif [[ $code -eq 10 ]]; then
      die "Trivy encontró vulnerabilidades de severidad $SEVERITY (MERCURY_SCAN_STRICT=1)"
    fi
    echo "mercury-ci: Trivy terminó con código $code (intento $attempt de 3)" >&2
    [[ $attempt -lt 3 ]] && sleep 20
  done
  return "$code"
}

# Código de salida de Trivy cuando hay hallazgos: 10 en modo estricto, 0 si solo informa
trivy_exit_code() { [[ "$STRICT" == 1 ]] && echo 10 || echo 0; }

[[ $# -ge 1 ]] || { usage; exit 1; }
step="$1"; shift

case "$step" in
  login)
    : "${REGISTRY_USR:?falta REGISTRY_USR (credentials('registry'))}"
    : "${REGISTRY_PSW:?falta REGISTRY_PSW (credentials('registry'))}"
    echo "$REGISTRY_PSW" | docker login "$REGISTRY_HOST" -u "$REGISTRY_USR" --password-stdin
    ;;

  image-ref)
    [[ $# -eq 2 ]] || die "uso: image-ref <app> <tag>"
    valid_app "$1"
    image_ref "$1" "$2"
    ;;

  check-inbox)
    [[ $# -eq 1 ]] || die "uso: check-inbox <app>"
    valid_app "$1"
    [[ -d "/inbox/$1" ]] || die "no existe la carpeta inbox/$1"
    [[ -n "$(ls -A "/inbox/$1")" ]] || die "la carpeta inbox/$1 está vacía"
    echo "inbox/$1:"
    ls -la "/inbox/$1"
    ;;

  sonar)
    [[ $# -ge 1 ]] || die "uso: sonar <clave-proyecto> [args]"
    key="$1"; shift
    : "${SONAR_HOST_URL:?ejecutar dentro de withSonarQubeEnv('sonarqube')}"
    # La imagen del escáner lleva su carpeta de trabajo a /tmp del contenedor, que se
    # pierde al terminar. Se fija dentro del workspace: ahí busca Jenkins el archivo
    # report-task.txt que necesita waitForQualityGate.
    in_workspace \
      -e SONAR_HOST_URL="$SONAR_HOST_URL" \
      -e SONAR_TOKEN="${SONAR_AUTH_TOKEN:?}" \
      "$SONAR_SCANNER_IMAGE" \
      -Dsonar.projectKey="$key" -Dsonar.sources=. \
      -Dsonar.working.directory="$PWD/.scannerwork" "$@"
    ;;

  semgrep)
    args=(scan --config p/default --metrics off --json-output semgrep.json)
    [[ "$STRICT" == 1 ]] && args+=(--error)
    # Mismo UID que el agente: git reconoce el repo y el informe queda con su dueño
    in_workspace --user "$(id -u):$(id -g)" -e HOME=/tmp "$SEMGREP_IMAGE" semgrep "${args[@]}" .
    ;;

  trivy-fs)
    trivy_retry in_workspace -v mercury-trivy-cache:/root/.cache "$TRIVY_IMAGE" fs \
      --scanners vuln,secret,misconfig --severity "$SEVERITY" --exit-code "$(trivy_exit_code)" .
    : > "$TRIVY_DB_MARK"
    ;;

  package)
    [[ $# -eq 4 ]] || die "uso: package <runtime> <dir> <app> <tag>"
    runtime="$1"; context="$2"
    valid_app "$3"
    [[ -d "$context" ]] || die "no existe el directorio $context"

    # Dockerfile, de más a menos específico. Un Dockerfile del proyecto gana a la plantilla.
    choice="${MERCURY_DOCKERFILE:-}"
    if [[ -n "$choice" && "$choice" != template ]]; then
      dockerfile="$choice"
      origin="indicado en MERCURY_DOCKERFILE"
      [[ -f "$dockerfile" ]] || die "MERCURY_DOCKERFILE apunta a un archivo que no existe: $dockerfile"
    elif [[ "$choice" != template && -f "$context/Dockerfile" ]]; then
      dockerfile="$context/Dockerfile"
      origin="del proyecto, en $context"
    elif [[ "$choice" != template && -f Dockerfile ]]; then
      dockerfile="Dockerfile"
      origin="del proyecto, en la raíz del repo"
    else
      dockerfile="$TEMPLATES/$runtime/Dockerfile"
      origin="plantilla del runtime $runtime"
      [[ -f "$dockerfile" ]] || die "runtime desconocido: $runtime"
    fi

    # La versión del runtime sigue a la del agente (o al parámetro del canal manual)
    version="${RUNTIME_VERSION:-}"
    [[ "$version" == default ]] && version=""
    case "$runtime" in
      dotnet) version_arg=DOTNET_VERSION ;;
      spring) version_arg=JAVA_VERSION ;;
      node)   version_arg=NODE_VERSION ;;
      flask)  version_arg=PYTHON_VERSION ;;
      *)      version_arg="" ;;
    esac
    build_args=()
    shown="(versión por defecto del Dockerfile)"
    if [[ -n "$version" && -n "$version_arg" ]]; then
      build_args+=(--build-arg "$version_arg=$version")
      shown="$version"
    fi

    ref="$(image_ref "$3" "$4")"
    echo "Dockerfile: $dockerfile ($origin)"
    echo "Contexto:   $context"
    echo "Runtime:    $runtime $shown"
    echo "Imagen:     $ref"
    docker buildx build --pull --load -t "$ref" -f "$dockerfile" "${build_args[@]}" "$context"
    docker push "$ref"
    echo "Imagen publicada: $ref"
    ;;

  trivy-image)
    [[ $# -eq 1 ]] || die "uso: trivy-image <imagen>"
    # En el canal manual no hay trivy-fs previo: no existe el marcador y la base se actualiza
    db_args=()
    [[ -f "$TRIVY_DB_MARK" ]] && db_args=(--skip-db-update)
    trivy_retry docker run --rm --memory "$SCAN_MEMORY" --network "$AGENT_NETWORK" -e DOCKER_HOST="${DOCKER_HOST:?}" \
      -v mercury-trivy-cache:/root/.cache "$TRIVY_IMAGE" image "${db_args[@]}" \
      --severity "$SEVERITY" --exit-code "$(trivy_exit_code)" "$1"
    ;;

  deploy)
    [[ $# -eq 3 ]] || die "uso: deploy <app> <dev|prod> <tag>"
    valid_app "$1"
    [[ "$2" == dev || "$2" == prod ]] || die "ambiente inválido: '$2' (dev o prod)"
    APP="$1" APP_ENV="$2" IMAGE="$(image_ref "$1" "$3")" \
      docker compose -f "$TEMPLATES/compose.deploy.yaml" up -d --pull always --wait --wait-timeout 120
    echo "Desplegado: contenedor $1-$2 en la red net-apps-$2, puerto 8080"
    ;;

  *)
    usage
    die "paso desconocido: $step"
    ;;
esac
