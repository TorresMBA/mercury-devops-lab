// Canal manual: toma el compilado copiado por SFTP/Samba a inbox/<APP>, lo empaqueta
// con el Dockerfile plantilla del runtime (o el que traiga el compilado) y lo despliega
// igual que el canal CI.
// Los parámetros APP, RUNTIME, RUNTIME_VERSION y TARGET_ENV se definen en
// stacks/devops/jenkins/casc/jenkins.yaml.
pipeline {
  agent { label 'base' }

  // Sin disableConcurrentBuilds: se pueden publicar apps distintas a la vez.
  // El lock de "Desplegar" evita dos despliegues simultáneos de la misma app y ambiente.
  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    REGISTRY = credentials('registry') // expone REGISTRY_USR y REGISTRY_PSW
    TAG = "manual-${BUILD_NUMBER}"
  }

  stages {
    stage('Validar') {
      steps {
        sh 'mercury-ci check-inbox "$APP"'
      }
    }

    stage('Empaquetar') {
      steps {
        // mercury-ci package lee RUNTIME_VERSION del entorno ("default" = la de la plantilla)
        sh '''
          mercury-ci login
          mercury-ci package "$RUNTIME" "/inbox/$APP" "$APP" "$TAG"
        '''
      }
    }

    stage('Trivy') {
      steps {
        sh 'mercury-ci trivy-image "$(mercury-ci image-ref "$APP" "$TAG")"'
      }
    }

    stage('Desplegar') {
      steps {
        lock("deploy-${params.APP}-${params.TARGET_ENV}") {
          sh 'mercury-ci deploy "$APP" "$TARGET_ENV" "$TAG"'
        }
      }
    }
  }
}
