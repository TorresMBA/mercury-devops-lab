NPM_VERSION=2.16.0
CLOUDFLARED_VERSION=2026.9.3
WHOAMI_VERSION=v1.12.0

# Token del túnel: Cloudflare Zero Trust > Networks > Tunnels > crear túnel (cloudflared).
# El valor real va solo en .env (este archivo se sube a git).
TUNNEL_TOKEN=

# Perfiles opcionales separados por coma: tunnel (cloudflared), test (whoami)
COMPOSE_PROFILES=
