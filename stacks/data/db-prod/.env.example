POSTGRES_VERSION=17.11-alpine
MARIADB_VERSION=11.4.8
MSSQL_VERSION=2022-CU20-ubuntu-22.04

# Claves de administrador (postgres, root, sa). El valor real va solo en .env.
# Distintas de las de dev. SQL Server exige 8+ caracteres con mayúsculas, minúsculas y números o símbolos.
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
MARIADB_ROOT_PASSWORD=cambiar-por-una-clave-larga
MSSQL_SA_PASSWORD=Cambiar-por-una-clave-larga-1

# Edición de SQL Server: Express es gratuita para producción (10 GB por base, 1 socket)
MSSQL_PID=Express

# Motores que también arrancan con ./mercury up all, separados por coma: postgres,mariadb,mssql
# Vacío = todos a demanda (./mercury db up prod <motor>)
COMPOSE_PROFILES=
