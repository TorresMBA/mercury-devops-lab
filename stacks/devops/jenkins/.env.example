JENKINS_VERSION=2.580.1-lts-jdk21
AGENT_VERSION=3391.va_37fa_a_305d6d-3-jdk21
SOCKET_PROXY_VERSION=v0.5.0

# Agentes de build simultáneos en todo el servidor. Cada uno reserva hasta 2 GB de RAM,
# más sus escáneres: con 12 GB no conviene pasar de 2 si SonarQube está en marcha.
JENKINS_MAX_AGENTS=2

JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambiar-por-una-clave-larga

# Usuario del registry creado con: ./mercury registry-user <usuario>
REGISTRY_USER=jenkins
REGISTRY_PASSWORD=cambiar

# Token de análisis generado en SonarQube (Mi cuenta > Seguridad). Rellenar tras levantar SonarQube.
SONAR_TOKEN=pendiente

# Los tokens de las cuentas de git (GitHub, GitLab...) van aparte, en credentials.env
