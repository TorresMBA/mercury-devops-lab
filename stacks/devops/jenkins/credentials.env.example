# Tokens de las cuentas de git que usa Jenkins. Copiar a credentials.env (no se versiona)
# y proteger: chmod 600 credentials.env
# Cada par de variables corresponde a una credencial de casc/credentials.yaml.
# Tras editar: ./mercury up jenkins
#
# Sin comillas ni espacios alrededor del "=". Basta un token con permiso de solo
# lectura sobre los repositorios (GitHub: Contents read; GitLab: read_repository).

# Credencial "github-mercury"
GITHUB_MERCURY_USER=pendiente
GITHUB_MERCURY_TOKEN=pendiente

# Credencial "gitlab-mercury"
GITLAB_MERCURY_USER=pendiente
GITLAB_MERCURY_TOKEN=pendiente
