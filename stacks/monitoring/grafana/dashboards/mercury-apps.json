{
  "uid": "mercury-apps",
  "title": "Mercury - Apps",
  "description": "Apps desplegadas (<app>-dev y <app>-prod): versión, consumo, reinicios y logs. Las nuevas aparecen solas",
  "tags": [
    "mercury"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "mercury"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Mercury"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Apps en marcha",
      "description": "Imagen = versión desplegada (la etiqueta es el número de build). Una app que no aparece no está en marcha.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Contenedor",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name, image) (container_last_seen{image=~\".*/apps/.*\", name=~\"$app\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (name, image) (time() - container_start_time_seconds{image=~\".*/apps/.*\", name=~\"$app\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (name, image) (container_memory_working_set_bytes{image=~\".*/apps/.*\", name=~\"$app\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (name, image) (100 * container_memory_working_set_bytes{image=~\".*/apps/.*\", name=~\"$app\"} / (container_spec_memory_limit_bytes{image=~\".*/apps/.*\", name=~\"$app\"} > 0))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "max by (name, image) (100 * rate(container_cpu_usage_seconds_total{image=~\".*/apps/.*\", name=~\"$app\"}[5m]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true
            },
            "renameByName": {
              "name": "Contenedor",
              "image": "Imagen",
              "Value #B": "En marcha desde hace",
              "Value #C": "Memoria",
              "Value #D": "% de su límite",
              "Value #E": "CPU"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "En marcha desde hace"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memoria"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% de su límite"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 75
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Consumo",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memoria",
      "description": "Si crece sin parar hasta el límite y el contenedor se reinicia, hay una fuga o APP_MEM_LIMIT es corto.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_working_set_bytes{image=~\".*/apps/.*\", name=~\"$app\"}",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU",
      "description": "100 % equivale a un núcleo completo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(container_cpu_usage_seconds_total{image=~\".*/apps/.*\", name=~\"$app\"}[5m])",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Red",
      "description": "Aproxima el tráfico de la app; enviado en negativo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{image=~\".*/apps/.*\", name=~\"$app\"}[5m]))",
          "legendFormat": "{{name}} recibido"
        },
        {
          "refId": "B",
          "expr": "-sum by (name) (rate(container_network_transmit_bytes_total{image=~\".*/apps/.*\", name=~\"$app\"}[5m]))",
          "legendFormat": "{{name}} enviado"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Arranques (despliegues o reinicios)",
      "description": "Cada despliegue recrea el contenedor y cuenta como un arranque. Varios seguidos sin desplegar = la app se está cayendo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "changes(container_start_time_seconds{image=~\".*/apps/.*\", name=~\"$app\"}[30m])",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Líneas de log por app",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({container=~\"$app\"} [$__interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Líneas con error por app",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 7
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (count_over_time({container=~\"$app\"} |~ \"(?i)(error|exception|fatal)\" [$__interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Logs (filtra con el cuadro \"Buscar\")",
      "description": "Últimas líneas de las apps elegidas arriba. El cuadro Buscar admite texto o una expresión regular.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 14
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"$app\"} |~ \"(?i)$buscar\""
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(container_last_seen{image=~\".*/apps/.*\"}, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(container_last_seen{image=~\".*/apps/.*\"}, name)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "buscar",
        "label": "Buscar en logs",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  }
}
