{
  "uid": "mercury-cicd",
  "title": "Mercury - CI/CD",
  "description": "Estado de la plataforma: Jenkins, builds, agentes efímeros, escáneres y servicios de soporte",
  "tags": [
    "mercury"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "mercury"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "Mercury"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jenkins",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"jenkins\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CAÍDO"
                },
                "1": {
                  "text": "EN MARCHA"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Servicios en marcha",
      "description": "De 9: jenkins, socket-proxy, sonarqube, sonar-db, registry, registry-ui, npm, adguard, cloudflared. Si falta alguno, la tabla de memoria de abajo dice cuál.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(container_last_seen{name=~\"jenkins|socket-proxy|sonarqube|sonar-db|registry|registry-ui|npm|adguard|cloudflared\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "green",
                "value": 9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Builds en cola",
      "description": "Builds esperando un agente. Si se queda alto con agentes libres, revisar la etiqueta del Jenkinsfile y JENKINS_MAX_AGENTS.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(default_jenkins_executors_queue_length)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Agentes en marcha",
      "description": "Contenedores de agente efímeros: existen solo mientras dura un build.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(container_last_seen{image=~\".*/agents/.*\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Escáneres en marcha",
      "description": "Trivy, Semgrep y sonar-scanner, que mercury-ci lanza como contenedores hermanos del agente.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(container_last_seen{image=~\".*(trivy|semgrep|sonar-scanner).*\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Destinos de Prometheus caídos",
      "description": "Destinos que Prometheus no consigue leer. Detalle: alerta ObjetivoCaido.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up == 0) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Builds",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "Último build por job",
      "description": "ABORTADO incluye rechazar Aprobar prod y los builds cancelados por uno más nuevo (abortPrevious).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 10
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Hace",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (jenkins_job) (default_jenkins_builds_last_build_result_ordinal{buildable=\"true\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "max by (jenkins_job) (default_jenkins_builds_last_build_duration_milliseconds{buildable=\"true\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "max by (jenkins_job) (time() * 1000 - default_jenkins_builds_last_build_start_time_milliseconds{buildable=\"true\"})",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "max by (jenkins_job) (default_jenkins_builds_health_score{buildable=\"true\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "jenkins_job": "Job",
              "Value #A": "Resultado",
              "Value #B": "Duración",
              "Value #C": "Hace",
              "Value #D": "Salud"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Resultado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "1": {
                        "text": "INESTABLE",
                        "color": "yellow",
                        "index": 1
                      },
                      "2": {
                        "text": "FALLÓ",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "SIN EJECUTAR",
                        "color": "text",
                        "index": 3
                      },
                      "4": {
                        "text": "ABORTADO",
                        "color": "purple",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duración"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurationms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Hace"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurationms"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Salud"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 40
                    },
                    {
                      "color": "green",
                      "value": 80
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Builds iniciados por job (última hora)",
      "description": "Ventana móvil de una hora: cada build nuevo cambia la hora de inicio del último build del job.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (jenkins_job) (changes(default_jenkins_builds_last_build_start_time_milliseconds{buildable=\"true\"}[1h])) > 0",
          "legendFormat": "{{jenkins_job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Agentes y escáneres",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Contenedores de build en marcha",
      "description": "Cuándo hubo builds y con qué agente. Los huecos son tiempo sin builds.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (image) (container_last_seen{image=~\".*/agents/.*\"})",
          "legendFormat": "{{image}}"
        },
        {
          "refId": "B",
          "expr": "count by (image) (container_last_seen{image=~\".*(trivy|semgrep|sonar-scanner).*\"})",
          "legendFormat": "{{image}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Memoria de agentes y escáneres",
      "description": "Los escáneres corren fuera del límite del agente, con su propio --memory.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (image) (container_memory_working_set_bytes{image=~\".*/agents/.*\"})",
          "legendFormat": "{{image}}"
        },
        {
          "refId": "B",
          "expr": "sum by (image) (container_memory_working_set_bytes{image=~\".*(trivy|semgrep|sonar-scanner).*\"})",
          "legendFormat": "{{image}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Servicios de la plataforma",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Memoria respecto a su mem_limit",
      "description": "Por encima del 90 % sostenido salta ContenedorCercaDelLimite: revisar su mem_limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * container_memory_working_set_bytes{name=~\"jenkins|socket-proxy|sonarqube|sonar-db|registry|registry-ui|npm|adguard|cloudflared\"} / (container_spec_memory_limit_bytes{name=~\"jenkins|socket-proxy|sonarqube|sonar-db|registry|registry-ui|npm|adguard|cloudflared\"} > 0)",
          "instant": true,
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "CPU por servicio",
      "description": "100 % equivale a un núcleo completo.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(container_cpu_usage_seconds_total{name=~\"jenkins|socket-proxy|sonarqube|sonar-db|registry|registry-ui|npm|adguard|cloudflared\"}[5m])",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Errores en Jenkins, SonarQube, registry y proxy",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{container=~\"jenkins|socket-proxy|sonarqube|sonar-db|registry|registry-ui|npm|adguard|cloudflared\"} |~ \"(?i)(severe|error|exception|fatal)\""
        }
      ]
    }
  ]
}
